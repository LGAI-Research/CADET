+"""``--outline_obs`` reaches the LLM env's EnvConfig; unset keeps the env default."""
+import pytest
+
+from configs.loader.schema import EnvConfig
+
+
+def _wrapper(monkeypatch, **kw):
+    from methods.llm_agent.wrappers.adapter import KiCadLLMWrapper
+    # Skip the engine: only the EnvConfig the wrapper would build is under test.
+    monkeypatch.setattr(KiCadLLMWrapper, "_build_env", lambda self, board_path: None)
+    return KiCadLLMWrapper(board_path="b.kicad_pcb", max_steps=10, masking_rule="strict",
+                           reward_rule="default", seed=0, **kw)
+
+
+@pytest.mark.parametrize("mode", ["tess", "arc"])
+def test_outline_obs_reaches_env_config(monkeypatch, mode):
+    assert _wrapper(monkeypatch, outline_obs=mode)._env_config.outline_obs == mode
+
+
+def test_unset_outline_obs_keeps_env_default(monkeypatch):
+    assert _wrapper(monkeypatch)._env_config.outline_obs == EnvConfig().outline_obs
+
+
+def test_flag_is_on_the_llm_eval_parser():
+    from eval.args import build_eval_parser
+    assert build_eval_parser().parse_args(["--outline_obs", "tess"]).outline_obs == "tess"
+    assert build_eval_parser().parse_args([]).outline_obs is None
