+"""Prompt v7 = v6 without the ``finish`` action (for ``default_no_finish`` masking)."""
+from methods.llm_agent.wrappers.prompts import PCBWORLD_PROMPT_VERSIONS, get_pcbworld_prompts
+
+_FIELDS = ("PCBWORLD_SYSTEM_PROMPT", "PCBWORLD_USER_PROMPT_NO_HIS",
+           "PCBWORLD_USER_PROMPT", "PCBWORLD_TEMPLATE_NO_HIS", "PCBWORLD_TEMPLATE")
+
+
+def test_v7_is_selectable():
+    assert "v7" in PCBWORLD_PROMPT_VERSIONS
+    assert get_pcbworld_prompts("v7").version == "v7"
+
+
+def test_v7_never_offers_finish():
+    v6, v7 = get_pcbworld_prompts("v6"), get_pcbworld_prompts("v7")
+    text = "\n".join(getattr(v7, f) for f in _FIELDS)
+    assert "finish" not in text
+    # v6 does mention it, so the check above is not vacuous
+    assert "finish" in "\n".join(getattr(v6, f) for f in _FIELDS)
diff --git a/tests/test_llm_rollout_early_stop.py b/tests/test_llm_rollout_early_stop.py
new file mode 100644
index 0000000..341621a
--- /dev/null
+++ b/tests/test_llm_rollout_early_stop.py
@@ -0,0 +1,110 @@
+"""The shared geometry early-stop guard and its wiring into the LLM rollout.
+
+``NoGeometryProgressGuard`` is the RL eval's guard; the LLM rollout exposes the
+same guard as ``--early_stop_no_geometry_progress``. The rollout test drives
+``_run_one_episode`` with a fake manager whose board never changes, so no
+engine or API is needed.
+"""
+from types import SimpleNamespace
+
+from methods._shared.early_stop import NoGeometryProgressGuard
+
+_STALL = {"track_count": 4, "via_count": 1, "wirelength": 12.5,
+          "ratsnest_reduction": 0.5}
+
+
+def test_guard_counts_unchanged_steps_and_resets_on_change():
+    g = NoGeometryProgressGuard(threshold=3)
+    assert g.update(info=_STALL) is False          # first sighting: baseline
+    assert g.update(info=_STALL) is False and g.count == 1
+    assert g.update(info={**_STALL, "wirelength": 13.0}) is False and g.count == 0
+    assert g.update(info={**_STALL, "wirelength": 13.0}) is False
+    assert g.update(info={**_STALL, "wirelength": 13.0}) is False
+    assert g.update(info={**_STALL, "wirelength": 13.0}) is True and g.count == 3
+
+
+def test_guard_ignores_steps_without_geometry():
+    """Invalid steps carry no measures; they neither count nor reset."""
+    g = NoGeometryProgressGuard(threshold=1)
+    g.update(info=_STALL)
+    assert g.update(info={"action_success": False}) is False and g.count == 0
+    assert g.update(info=_STALL) is True
+
+
+class _StalledManager:
+    """Fake KiCadLLMRolloutManager: every step is a valid, board-unchanging one."""
+
+    def __init__(self, max_steps):
+        self.effective_max_steps = max_steps
+        self.episode_scored = [None]
+        self.marked_done = []
+        self._last_actions = [{}]
+        self._last_valids = [True]
+
+    @staticmethod
+    def _obs():
+        return {"anchor": ["obs"], "system": ["sys"], "text": ["usr"]}
+
+    def reset(self):
+        return self._obs(), [dict(_STALL)]
+
+    def step(self, _outputs):
+        info = {**_STALL, "action_success": True}
+        return self._obs(), [0.0], [False], [info]
+
+    def mark_episode_done(self, idx, infos):
+        self.marked_done.extend(idx)
+
+    def finalize_episode(self, infos):
+        pass
+
+    def build_text_obs(self, obs, action_masks, init):
+        return ["sys"], ["final"]
+
+
+class _Provider:
+    def generate(self, prompt_pairs):
+        return ["<think>t</think><action>make_line 1 1 w</action>"], [(1, 1, 1)]
+
+
+def _run(threshold, max_steps=20):
+    from methods.llm_agent.rollout.pcbworld import _run_one_episode
+    args = SimpleNamespace(env_num=1, max_steps=max_steps, verbose=False,
+                           dump_dir=None, early_stop_no_progress=0,
+                           early_stop_no_geometry_progress=threshold)
+    mgr = _StalledManager(max_steps)
+    (result,) = _run_one_episode(
+        args, _Provider(), mgr, None, "b0", "b0.kicad_pcb", 0, "v7",
+        extract_think_action=None, is_no_progress=lambda _info: False,
+    )
+    return result, mgr
+
+
+def test_llm_rollout_stops_on_stalled_geometry():
+    result, mgr = _run(threshold=3)
+    # step 0 sets the baseline, steps 1..3 are unchanged -> stop after 4 steps
+    assert result["steps"] == 4
+    assert result["early_stopped"] is True
+    assert result["early_stop_reason"] == "no_geometry_progress"
+    assert mgr.marked_done == [0]
+
+
+def test_llm_rollout_guard_off_runs_to_max_steps():
+    result, _ = _run(threshold=0, max_steps=6)
+    assert result["steps"] == 6 and result["early_stopped"] is False
+    assert result["early_stop_reason"] == ""
+
+
+def test_early_stop_reason_reaches_canonical_row():
+    from methods.llm_agent.rollout.pcbworld import _result_to_canonical_row
+    result, _ = _run(threshold=3)
+    row = _result_to_canonical_row(result, board_index=0, board_path="b0.kicad_pcb",
+                                   rollout_idx=0)
+    assert row["early_stop"] is True
+    assert row["early_stop_reason"] == "no_geometry_progress"
+
+
+def test_flag_is_on_the_llm_eval_parser():
+    from eval.args import build_eval_parser
+    args = build_eval_parser().parse_args(["--early_stop_no_geometry_progress", "10"])
+    assert args.early_stop_no_geometry_progress == 10
