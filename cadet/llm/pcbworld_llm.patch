diff --git a/tests/test_llm_api_provider.py b/tests/test_llm_api_provider.py
new file mode 100644
index 0000000..41388bb
--- /dev/null
+++ b/tests/test_llm_api_provider.py
@@ -0,0 +1,198 @@
+"""OpenAI request shape, error handling and token accounting of the API provider (no network).
+
+The OpenAI client is replaced by a fake that records the request, so these
+tests pin what a reasoning-model run (e.g. gpt-6-astra) actually sends, that
+an out-of-credit / bad-key error stops the run instead of being turned into
+idle steps, and the per-board ``token_usage.json`` layout.
+"""
+from types import SimpleNamespace
+
+import pytest
+
+from methods.llm_agent.policy import model_provider as mp
+
+
+class _FakeOpenAI:
+    """Stands in for ``openai.OpenAI``; records the last create() kwargs."""
+    last_kwargs: dict = {}
+
+    def __init__(self, **_client_kwargs):
+        self.chat = SimpleNamespace(completions=SimpleNamespace(create=self._create))
+
+    def _create(self, **kwargs):
+        type(self).last_kwargs = kwargs
+        return SimpleNamespace(
+            choices=[SimpleNamespace(message=SimpleNamespace(content="<think>t</think>"))],
+            usage=SimpleNamespace(prompt_tokens=11, completion_tokens=7),
+        )
+
+
+@pytest.fixture
+def fake_openai(monkeypatch):
+    monkeypatch.setattr("openai.OpenAI", _FakeOpenAI)
+    return _FakeOpenAI
+
+
+def test_gpt6_takes_reasoning_request_shape(fake_openai):
+    mp._call_openai("SYS", "USR", "gpt-6-astra", 0.7, 4000,
+                    reasoning_effort="medium")
+    kw = fake_openai.last_kwargs
+    assert [m["role"] for m in kw["messages"]] == ["developer", "user"]
+    assert kw["max_completion_tokens"] == 4000 and "max_tokens" not in kw
+    assert "temperature" not in kw
+    assert kw["reasoning_effort"] == "medium"
+
+
+def test_chat_model_keeps_temperature_and_max_tokens(fake_openai):
+    mp._call_openai("SYS", "USR", "gpt-4o", 0.7, 256)
+    kw = fake_openai.last_kwargs
+    assert [m["role"] for m in kw["messages"]] == ["system", "user"]
+    assert kw["temperature"] == 0.7 and kw["max_tokens"] == 256
+    assert "reasoning_effort" not in kw
+
+
+def _provider_args(**over):
+    base = dict(api_provider="openai", api_model="gpt-6-astra", temperature=0.7,
+                max_new_tokens=4000, api_key=None, api_reasoning_effort=None)
+    base.update(over)
+    return SimpleNamespace(**base)
+
+
+@pytest.mark.parametrize("provider,model", [("openai", "gpt-4o"),
+                                            ("anthropic", "claude-sonnet-4-20250514")])
+def test_reasoning_effort_rejected_where_it_cannot_apply(provider, model):
+    with pytest.raises(ValueError, match="api_reasoning_effort"):
+        mp.APIProvider(_provider_args(api_provider=provider, api_model=model,
+                                      api_reasoning_effort="medium"))
+
+
+def test_provider_forwards_reasoning_effort():
+    seen = {}
+
+    def caller(*_a, **kw):
+        seen.update(kw)
+        return "<think>t</think>", (10, 5)
+
+    p = mp.APIProvider(_provider_args(api_reasoning_effort="medium"))
+    p.caller = caller
+    p.generate([("SYS", "USR")])
+    assert seen["reasoning_effort"] == "medium"
+
+
+class RateLimitError(Exception):
+    """Named like the OpenAI SDK class so the marker match sees the same text."""
+
+
+def test_out_of_credit_raises_instead_of_idle():
+    calls = []
+
+    def caller(*_a, **_kw):
+        calls.append(1)
+        raise RateLimitError("Error code: 429 - {'error': {'message': 'You exceeded "
+                             "your current quota', 'code': 'insufficient_quota'}}")
+
+    p = mp.APIProvider(_provider_args())
+    p.caller = caller
+    with pytest.raises(mp.FatalAPIError, match="insufficient_quota"):
+        p.generate([("SYS", "USR")])
+    assert len(calls) == 1          # no retry budget burnt
+
+
+def test_rate_limit_is_still_retried(monkeypatch):
+    monkeypatch.setattr(mp.time, "sleep", lambda _s: None)
+    outcomes = [RateLimitError("Error code: 429 - Rate limit reached for requests"),
+                ("<think>t</think><action>net_end</action>", (10, 5))]
+
+    def caller(*_a, **_kw):
+        out = outcomes.pop(0)
+        if isinstance(out, Exception):
+            raise out
+        return out
+
+    p = mp.APIProvider(_provider_args())
+    p.caller = caller
+    responses, _ = p.generate([("SYS", "USR")])
+    assert responses == ["<think>t</think><action>net_end</action>"]
+
+
+# Key order of token_usage.json.
+_TOKEN_USAGE_KEYS = ["calls", "failed_calls", "input_tokens", "cached_input_tokens",
+                     "cache_write_tokens", "output_tokens", "reasoning_tokens",
+                     "uncached_input_tokens", "model", "reasoning_effort", "wall_time_s"]
+
+
+def _usage(prompt, completion, cached, write, reasoning):
+    details = SimpleNamespace(cached_tokens=cached)
+    if write is not None:
+        details.cache_write_tokens = write
+    return SimpleNamespace(prompt_tokens=prompt, completion_tokens=completion,
+                           prompt_tokens_details=details,
+                           completion_tokens_details=SimpleNamespace(reasoning_tokens=reasoning))
+
+
+def _accounting_provider(usages):
+    p = mp.APIProvider(_provider_args(api_reasoning_effort="medium"))
+    queue = list(usages)
+
+    def caller(*_a, on_usage=None, **_kw):
+        u = queue.pop(0)
+        if isinstance(u, Exception):
+            raise u
+        on_usage(u)
+        return "<think>t</think>", (u.prompt_tokens, u.completion_tokens)
+
+    p.caller = caller
+    return p
+
+
+def test_openai_usage_split_is_accumulated():
+    p = _accounting_provider([_usage(1000, 40, 0, 1000, 5), _usage(1100, 60, 1000, 100, 15)])
+    p.generate([("S", "U"), ("S", "U")])
+    u = p.usage_snapshot()
+    assert (u["calls"], u["failed_calls"]) == (2, 0)
+    assert (u["input_tokens"], u["cached_input_tokens"], u["cache_write_tokens"]) == (2100, 1000, 1100)
+    assert (u["output_tokens"], u["reasoning_tokens"]) == (100, 20)
+    assert u["uncached_input_tokens"] == 1100          # input - cache hits (includes writes)
+    assert (u["model"], u["reasoning_effort"]) == ("gpt-6-astra", "medium")
+    p.reset_usage()
+    assert p.usage_snapshot()["calls"] == 0
+
+
+def test_failed_call_is_counted():
+    p = _accounting_provider([ValueError("Error code: 400 - bad request")])
+    p.generate([("S", "U")])
+    u = p.usage_snapshot()
+    assert (u["calls"], u["failed_calls"], u["input_tokens"]) == (1, 1, 0)
+
+
+def test_unreported_cache_write_stays_none():
+    p = _accounting_provider([_usage(1000, 40, 0, None, 0)])
+    p.generate([("S", "U")])
+    assert p.usage_snapshot()["cache_write_tokens"] is None
+
+
+def test_call_openai_hands_usage_to_hook(fake_openai):
+    seen = []
+    mp._call_openai("SYS", "USR", "gpt-6-astra", 0.7, 4000, on_usage=seen.append)
+    assert seen and seen[0].prompt_tokens == 11
+
+
+def test_token_usage_json_layout(tmp_path):
+    import json
+    from methods.llm_agent.rollout.pcbworld import _write_token_usage
+    p = _accounting_provider([_usage(1000, 40, 0, 1000, 5)])
+    p.generate([("S", "U")])
+    path = _write_token_usage(str(tmp_path), "0225", 1, p.usage_snapshot(), 12.34)
+    assert path.endswith("/token_usage.json")
+    doc = json.load(open(path))
+    assert list(doc) == _TOKEN_USAGE_KEYS and doc["wall_time_s"] == 12.3
+    # multi-board dump dir: one file per board
+    assert _write_token_usage(str(tmp_path), "0225", 3, p.usage_snapshot(), 1.0).endswith(
+        "/0225_token_usage.json")
+
+
+def test_resumed_board_keeps_earlier_token_usage(tmp_path):
+    from methods.llm_agent.rollout.pcbworld import _write_token_usage
+    p = _accounting_provider([])
+    assert _write_token_usage(str(tmp_path), "0225", 1, p.usage_snapshot(), 1.0) is None
+    assert not (tmp_path / "token_usage.json").exists()
